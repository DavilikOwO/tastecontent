# Copy this file to .env and fill in real values. NEVER commit .env.

# Qloo hackathon API (keys only work against the hackathon host).
# Locally you can skip QLOO_API_KEY if you already ran `qloo setup --qloo`.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Language model used to interpret the audience and write the plan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Force sample data (no network calls) even if keys are present: 1 = on.
QLOO_MOCK=0
LLM_MOCK=0

PORT=3000

# Usage limits (finished plans; cached plans are free). Leave empty locally: limits only
# apply by default on the published server (6 per visitor per hour, 150 per day).
RATE_LIMIT_PER_HOUR=
DAILY_PLAN_LIMIT=
